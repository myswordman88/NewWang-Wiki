# ============================================================

# ---------- 1. 内部数据 & AI 工作记录（不对外） ----------
.workbuddy/
memory/

# ---------- 2. 源数据 / 构建资源（体积大，不部署） ----------
resource/
assets/mod/

# ---------- 3. 图片源文件（成品是 assets/equipment/*.webp） ----------
assets/equipment/_preview/
*.sprite

# ---------- 4. 构建 / 维护脚本（不部署） ----------
tools/
/_build_*.py
/build_rune_images.py
/sprite_to_webp.py

# ---------- 5. 内部文档 & 数据库结构（不对外） ----------
/DEPLOYMENT.md
/网站更新规划.md
/supabase-schema.sql

# ---------- 6. 中间产物 / 临时文件 ----------
*.csv
*.bak
*.tmp
*.orig
*.log
/_*.txt

# ---------- 7. Python 缓存 ----------
__pycache__/
*.py[cod]

# ---------- 8. 系统 / 编辑器 / 部署缓存 ----------
.DS_Store
Thumbs.db
.vercel/
.idea/
